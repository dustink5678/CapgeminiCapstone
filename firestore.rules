rules_version = '2';

// Clients never talk to Firestore directly. The SPA calls Cloud Functions,
// which use the Admin SDK (bypasses rules). Seed data is written by
// database/seed.mjs with the project owner's credentials.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
