# Non-secret env (safe to deploy). Do NOT put GEMINI_API_KEY here —
# it overlaps Secret Manager and breaks Cloud Functions deploy.
#
# API key locations:
#   Emulator:  functions/.secret.local  →  GEMINI_API_KEY=...
#   Production: firebase functions:secrets:set GEMINI_API_KEY

# mock | live | off  (live in prod via secret; mock if no key)
GEMINI_MODE=live

# Simulated model latency for mock mode
GEMINI_MOCK_LATENCY_MS=250

# Model for live mode
GEMINI_MODEL=gemini-3.5-flash
