# Copy to .env.local for local Firebase client / API mode setup.

# demo = in-browser demoStore (default in vite dev)
# live = real /api calls (Hosting rewrite in prod, or Functions emulator via Vite proxy)
VITE_API_MODE=demo

# Optional: override Functions emulator host used by the Vite /api proxy
# VITE_FUNCTIONS_EMULATOR_HOST=http://127.0.0.1:5001
# VITE_FIREBASE_PROJECT_ID=capgeminidemo2

# Optional: absolute API base (usually leave empty so same-origin /api works)
# VITE_API_BASE=

# Web client config (only needed if you later add Firebase Auth in the browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=capgeminidemo2.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=capgeminidemo2
VITE_FIREBASE_STORAGE_BUCKET=capgeminidemo2.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
